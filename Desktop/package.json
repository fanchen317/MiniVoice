{
  "name": "minivoice-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "package": "electron-packager . 'MiniVoice' --platform=darwin --arch=arm64 --out=../.build/staging --asar --overwrite --app-bundle-id=com.xcosmos.MiniVoice.electron --icon=../AppBundle/MiniVoice.icns --electron-zip-dir=../.build --ignore='^/src|^/test|^/node_modules|^/vite.config'"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "19.0.3",
    "electron": "44.8.0",
    "vite": "8.3.4"
  }
}
