.DS_Store
.build/
# Only the repository-root build output; Scripts/build/ holds tracked scripts.
/build/
.idea/
.claude/

# Python runtime caches
__pycache__/
*.py[cod]

# Electron renderer and dependencies
MacOS/Desktop/node_modules/
MacOS/Desktop/dist/
Android/.gradle/
Android/.idea/
Android/local.properties
Android/app/build/

# Ignore private signing keys, except the shared development identity.
*.keystore
*.jks
Android/signing/*
!Android/signing/debug.keystore

# Dependencies and tool caches at any package depth
node_modules/
.vite/
.vite-temp/
