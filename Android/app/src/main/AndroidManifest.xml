<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.xcosmos.minivoice" android:versionCode="1" android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
